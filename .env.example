# VESK CRM — variáveis de ambiente
# Local: copie para server/.env (o servidor lê esse arquivo). Produção: Vercel → Settings → Environment Variables.

# ─── Obrigatórias ──────────────────────────────────────────────────────────────
# Banco Postgres (Neon / Vercel Postgres). Também aceita DATABASE_URL ou POSTGRES_PRISMA_URL.
POSTGRES_URL=postgresql://user:pass@host/db?sslmode=require
# Segredo de assinatura das sessões. Use um valor longo e aleatório (ex.: `openssl rand -hex 48`).
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# ─── Aplicação ─────────────────────────────────────────────────────────────────
# URL pública do CRM. Usada nos webhooks do WhatsApp, nos scripts dos botões/formulários e nos links de convite.
WHATSAPP_WEBHOOK_PUBLIC_URL=https://seu-app.vercel.app
PRODUCTION_APP_URL=https://seu-app.vercel.app
# Origens permitidas por CORS (separadas por vírgula). Em produção na Vercel (mesmo domínio) pode ficar vazio.
FRONTEND_URL=http://localhost:5173
# Porta do servidor local
PORT=3001
# Frontend: só defina se a API estiver em outro domínio. Em produção na Vercel deixe vazio (usa /api).
# VITE_API_URL=/api

# ─── Acesso e segurança ────────────────────────────────────────────────────────
# Cria o primeiro administrador se ainda não existir (opcional; senha com 8+ caracteres).
# SEED_ADMIN_EMAIL=admin@empresa.com
# SEED_ADMIN_PASSWORD=
# Cadastro público (POST /api/auth/register). Deixe desligado em produção: novos usuários entram por convite.
# ALLOW_PUBLIC_REGISTER=false
# Assinatura do webhook da Meta: por padrão é exigida. `warn` só registra aviso (use para destravar mensagens
# quando o App Secret cadastrado no CRM estiver errado — e volte ao padrão depois).
# WHATSAPP_SIGNATURE_MODE=warn
# Força reexecutar as migrações mesmo sem mudança no esquema.
# FORCE_MIGRATIONS=true

# ─── WhatsApp (API oficial Meta) ───────────────────────────────────────────────
# O token e o App Secret de cada conta são cadastrados pelo CRM (Integrações → WhatsApp). Estas são opcionais:
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_API_VERSION=v21.0

# ─── Armazenamento de arquivos (Vercel Blob) ───────────────────────────────────
# Necessário para anexos do WhatsApp, modelos de proposta e uploads. Sem ele, cai para data URL (limitado).
BLOB_READ_WRITE_TOKEN=

# ─── E-mail (convites e propostas) ─────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ─── Notificações push (web-push) ──────────────────────────────────────────────
# Gere as chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@empresa.com

# ─── Scraping Google Maps ──────────────────────────────────────────────────────
# Serviço Python + Playwright (pasta scraper/). Local: `npm run scraper` → MAPS_SCRAPER_URL=http://localhost:8765
MAPS_SCRAPER_URL=
# Alternativa paga (só usada se MAPS_SCRAPER_URL estiver vazio)
GOOGLE_MAPS_API_KEY=

# ─── Lembretes da Agenda ───────────────────────────────────────────────────────────────────────────
# Segredo do agendador que chama GET /api/cron/reminders a cada minuto (Authorization: Bearer <CRON_SECRET>).
# Sem ele o endpoint responde 503; os lembretes ainda disparam enquanto alguém estiver com o CRM aberto.
# CRON_SECRET=

# ─── Google Agenda + Meet (opcional) ─────────────────────────────────────────────
# Crie em console.cloud.google.com: ative a "Google Calendar API", configure a tela de consentimento e crie uma
# credencial "ID do cliente OAuth" (aplicativo da Web) com a URI de redirecionamento
# <URL pública>/api/google/callback (local: http://localhost:3001/api/google/callback). Detalhes no README.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Só defina se a URI de redirecionamento for diferente da padrão.
# GOOGLE_REDIRECT_URI=
# Chave que criptografa os tokens do Google no banco. Sem ela é derivada do JWT_SECRET.
# GOOGLE_TOKEN_KEY=

# ─── Monitoramento ─────────────────────────────────────────────────────────────
# Nível mínimo dos logs do servidor: debug | info | warn | error (padrão: info)
# LOG_LEVEL=info
